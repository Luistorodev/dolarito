# Dolarito — environment variables.
# Copy to .env and fill in. Never commit .env.

# --- Supabase (T002) -------------------------------------------------------
SUPABASE_URL=

# Ingestion writes with this key only. It lives in the GitHub Actions secrets
# and must never reach a browser bundle (constitution Art. V, plan.md 2.3).
SUPABASE_SERVICE_ROLE_KEY=

# Used only by the negative RLS test in T005: with no anonymous read policy,
# this key must fail both read and write. Not used by the app at runtime.
SUPABASE_ANON_KEY=

# --- Web server-side reads (T023) ------------------------------------------
# plan.md 2.3 requires every read to happen server-side with a server key, so
# no credential reaches the browser. WHICH key this is, is still undecided:
# reusing SUPABASE_SERVICE_ROLE_KEY would give the web tier write access it
# does not need. Pending decision before T023.
SUPABASE_SERVER_READ_KEY=

# --- Site protection (T022, HU-07) -----------------------------------------
# Shared password for the private period. Removing protection is a config
# change, not a code change.
SITE_PASSWORD=

# --- Outbound HTTP identity (T006c, constitution Art. V.4) -----------------
# Honest, identifiable User-Agent with a way to reach us. Never impersonate a
# browser to get around controls.
INGEST_USER_AGENT="dolarito/0.1 (+https://example.invalid; contact@example.invalid)"
