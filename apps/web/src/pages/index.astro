---
/**
 * Home: TRM, freshness and the rankings.
 *
 * T021 shell, T023 data, T024 TRM, T026 freshness, T025 partial.
 *
 * ## The selector filters what is already here
 *
 * All four brackets arrive in one response (T023). There is no public read
 * (N4), so the browser cannot go back for more — every combination is rendered
 * server-side and the selector only changes which one is shown.
 *
 * ## Why both directions render, always
 *
 * On a phone the direction selector picks one. On a wide screen both sit side
 * by side and the selector disappears, because the extra width is exactly what
 * "¿me conviene comprar o vender?" needs — the two answers next to each other.
 * That is also the fix for the desktop layout note: the page was a narrow
 * column with half the screen empty.
 *
 * The narrow case is the default in the markup, so with no JavaScript the page
 * still shows a working ranking.
 *
 * ## One list, not two (2026-09-16)
 *
 * There used to be a Local/Remesa selector, and its cost was that **three of
 * the eight providers were invisible**: the control said "Local | Remesa" and
 * nothing on the page said Wise was behind the second one. Somebody who did not
 * already know Wise is a remittance service had no reason to press it.
 *
 * Art. III.2 allows the merge and names its price: *"Pueden verse juntos, pero
 * cada fila declara su `asset` y su `channel` de forma visible."* So every row
 * now carries a mode tag as well. **Removing the control does not remove the
 * distinction it carried** — it moves into the row.
 *
 * What this costs, said plainly rather than discovered later: a remittance and
 * an exchange are not the same product, and now they sit in one ordered list.
 * The order is still Art. III.1's — most pesos received, or fewest paid — which
 * is a fair question to ask of both. The tag is what stops the list from
 * implying they are interchangeable.
 *
 * ## What the 2026-09-16 restyle did NOT touch
 *
 * The remaining controls kept their structure and their weight relative to
 * each other. **How prominent the amount selector is, is decision #2 of the
 * T020 barrier** (`BracketEmphasis`), so featuring it here would have taken
 * that decision by accident — which is the exact failure working rule 4 exists
 * to prevent. Restyling them alike is not choosing between them, and neither is
 * removing a third control that was about something else entirely.
 */
import AvisoFrescura from '../components/AvisoFrescura.astro';
import BloqueTrm from '../components/BloqueTrm.astro';
import Ranking from '../components/Ranking.astro';
import Base from '../layouts/Base.astro';
import { PROVIDER_IDS } from '../lib/catalogue.ts';
import { describeFreshness, findMissing } from '../lib/freshness.ts';
import { DECIDE_ON } from '../lib/pending.ts';
import { fetchLatestQuotes, type LatestQuote } from '../lib/quotes.ts';
import { availableSelections, directionLabel, select } from '../lib/ranking.ts';

const now = new Date();
const result = await fetchLatestQuotes();
const quotes = result.kind === 'ok' ? result.quotes : [];

const freshness = describeFreshness(quotes, now);
const missing = quotes.length === 0 ? [] : findMissing(PROVIDER_IDS, quotes);
const trmSource = quotes.find((q) => q.trm !== null);

/**
 * The Eldorado policy, deliberately not chosen.
 *
 * `undefined` is the open state: its rows are set aside instead of being
 * ranked. Writing a policy here would take one of the three T025 decisions by
 * accident, which is what working rule 4 exists to stop. It gets decided on
 * 2026-09-21 with the measured week.
 */
const ELDORADO_POLICY = undefined;

const selections = availableSelections(quotes);
const directions = [...new Set(selections.map((s) => s.direction))];
const brackets = [...new Set(selections.map((s) => s.bracket))].sort((a, b) => a - b);

const defaults = {
  direction: 'usd_to_cop' as LatestQuote['direction'],
  bracket: brackets.includes(100) ? 100 : (brackets[0] ?? 100),
};

/** One look for both groups, so neither claims more weight. */
const GROUP = 'border-border bg-card flex gap-0.5 rounded-lg border p-0.5 shadow-xs';
const OPTION =
  'block cursor-pointer rounded-md px-3 py-1.5 text-sm whitespace-nowrap text-muted-foreground transition-colors peer-checked:bg-accent peer-checked:text-accent-foreground peer-checked:font-semibold peer-focus-visible:outline-2 peer-focus-visible:outline-offset-1 peer-focus-visible:outline-ring hover:text-foreground';
---

<Base
  title="Dolarito"
  description="Comparador de precios de compra y venta de dólares para Colombia."
>
  <header class="mb-6">
    <div class="flex items-center gap-3">
      {/* Decorative: `alt=""` because the wordmark next to it already says the
          name, and a screen reader announcing "Dolarito" twice is noise. The
          width and height are set so the line does not jump while it loads. */}
      <img
        src="/logo-64.png"
        width="40"
        height="40"
        alt=""
        class="size-10 shrink-0"
        fetchpriority="high"
      />
      <div class="flex items-baseline gap-2">
        <h1 class="m-0 text-2xl font-bold tracking-tight sm:text-3xl">Dolarito</h1>
        <span aria-hidden="true" class="bg-primary/70 h-1.5 w-1.5 shrink-0 rounded-full"></span>
        <span class="text-faint text-xs font-medium tracking-wide uppercase">
          USD · COP
        </span>
      </div>
    </div>
    <p class="text-muted-foreground m-0 mt-2 max-w-measure text-sm">
      Cuántos pesos recibís por tus dólares, y cuántos te cuesta comprarlos.
      Comparado a monto fijo, entre ocho proveedores.
    </p>
  </header>

  {
    result.kind === 'failed' && (
      <section
        role="alert"
        class="border-border-strong bg-warn-soft rounded-lg border p-4"
      >
        <h2 class="m-0 mb-2 text-base font-semibold">No se pudieron leer los precios</h2>
        <p class="text-muted-foreground m-0 text-sm">{result.reason}</p>
        <p class="text-faint m-0 mt-2 text-xs">
          La captura sigue corriendo cada 15 minutos: esto es un problema de
          lectura, no de datos.
        </p>
      </section>
    )
  }

  {
    result.kind === 'empty' && (
      <section class="border-border-strong bg-warn-soft rounded-lg border p-4">
        <h2 class="m-0 mb-2 text-base font-semibold">
          No hay precios de las últimas 24 horas
        </h2>
        <p class="text-faint m-0 text-xs">
          La vista solo muestra capturas recientes. Si esto persiste, algo dejó
          de capturar.
        </p>
      </section>
    )
  }

  {
    result.kind === 'ok' && (
      <>
        <BloqueTrm source={trmSource} now={now} />
        <AvisoFrescura freshness={freshness} missing={missing} />

        <form
          class="my-6 flex flex-wrap gap-3"
          id="selector"
          aria-label="Qué comparar"
        >
          <fieldset class={`m-0 lg:hidden ${GROUP}`}>
            <legend class="sr-only">Dirección</legend>
            {directions.map((direction) => (
              <label class="relative flex">
                <input
                  type="radio"
                  name="direccion"
                  value={direction}
                  checked={direction === defaults.direction}
                  class="peer absolute inset-0 cursor-pointer opacity-0"
                />
                <span class={OPTION}>{directionLabel(direction)}</span>
              </label>
            ))}
          </fieldset>

          <fieldset class={`m-0 ${GROUP}`}>
            <legend class="sr-only">Monto</legend>
            {brackets.map((bracket) => (
              <label class="relative flex">
                <input
                  type="radio"
                  name="monto"
                  value={bracket}
                  checked={bracket === defaults.bracket}
                  class="peer absolute inset-0 cursor-pointer opacity-0"
                />
                <span class={`amount ${OPTION}`}>{bracket} USD</span>
              </label>
            ))}
          </fieldset>
        </form>

        <div class="grid gap-8 lg:grid-cols-2 lg:items-start lg:gap-10" id="tablero">
          {selections.map((selection) => (
            <div
              class="panel"
              data-dir={selection.direction}
              data-monto={String(selection.bracket)}
              hidden={selection.bracket !== defaults.bracket}
              data-dir-oculta={selection.direction !== defaults.direction ? '' : undefined}
            >
              <Ranking
                quotes={select(quotes, selection)}
                direction={selection.direction}
                bracket={selection.bracket}
                now={now}
                eldorado={ELDORADO_POLICY}
              />
            </div>
          ))}
        </div>

        <p class="text-faint border-border mt-8 border-t pt-4 text-xs">
          Cómo se muestra El Dorado —el único con varios métodos de pago— se
          decide el {DECIDE_ON}, con una semana de datos medidos. Hasta entonces
          sus precios se ven aparte y no entran en el orden.
        </p>
      </>
    )
  }
</Base>

<script>
  // Progressive enhancement: the server already rendered the default panel
  // visible, so with no JavaScript the page still shows a working ranking.
  const form = document.querySelector<HTMLFormElement>('#selector');
  const tablero = document.querySelector<HTMLElement>('#tablero');

  if (form && tablero) {
    const apply = (): void => {
      const data = new FormData(form);
      const direccion = String(data.get('direccion'));
      const monto = String(data.get('monto'));

      for (const panel of tablero.querySelectorAll<HTMLElement>('.panel')) {
        // The amount hides the panel outright, at any width.
        panel.hidden = panel.dataset['monto'] !== monto;

        // Direction only hides it on a narrow screen. A media query lets the
        // other one back in when there is room for both, so the decision of
        // "one or two rankings" stays in CSS rather than in a viewport check
        // here that would disagree with the stylesheet.
        if (panel.dataset['dir'] === direccion) panel.removeAttribute('data-dir-oculta');
        else panel.setAttribute('data-dir-oculta', '');
      }
    };

    form.addEventListener('change', apply);
    apply();
  }
</script>

<style>
  /* Narrow: one direction at a time, chosen by the selector.
     Wide: both side by side, and the direction selector goes away because
     there is nothing left for it to choose.

     This stays a media query rather than a `matchMedia` check in the script
     above on purpose: if the decision of "one ranking or two" lived in both,
     the two could disagree. The script only marks the attribute; the
     stylesheet decides whether the attribute hides anything. */
  .panel[data-dir-oculta] {
    display: none;
  }

  @media (min-width: 64rem) {
    .panel[data-dir-oculta] {
      display: block;
    }
  }
</style>
