---
/**
 * The one layout (T021).
 *
 * Deliberately thin. Everything that will carry data — the TRM block (T024),
 * the rankings (T025), freshness (T026) — arrives as a component inside the
 * slot, so none of it is wired into the shell before it is measured.
 */
// One stylesheet, and it owns every token. Tailwind v4 has no config file:
// the theme is the @theme block in here (2026-09-16).
import '../styles/global.css';

interface Props {
  title: string;
  description?: string | undefined;
}

const { title, description } = Astro.props;
const fullTitle = title === 'Dolarito' ? title : `${title} · Dolarito`;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <!-- RF-12: the phone is the main case, not an adaptation of the desktop. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <!--
      No indexing while the private period lasts (HU-07). The password gate is
      the real lock; this only asks crawlers not to try, and the two are
      independent on purpose.
    -->
    <meta name="robots" content="noindex, nofollow" />
    <!--
      Raster, not SVG: the logo is a rendered illustration, so there is no vector
      of it to ship. Two sizes rather than one scaled: a 64 px image squeezed
      into a 16 px tab is mush, and a 32 px one blown up to 180 is worse.

      These are in `PUBLIC_PREFIXES` (auth.ts) so they answer before the password
      gate — otherwise the login page would render its own logo as a broken
      image, which is a poor first impression of a site whose whole job is to
      look trustworthy about numbers.
    -->
    <link rel="icon" href="/logo-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/logo-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/logo-180.png" />
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>
