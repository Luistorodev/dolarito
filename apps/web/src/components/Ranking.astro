---
/**
 * One ranking: a direction and a bracket (T025, partial).
 *
 * **Not a mode.** Local and Remesa shared one list from 2026-09-16; each row
 * carries a mode tag instead, which is what Art. III.2 requires of a list that
 * mixes products.
 *
 * Order comes from `rank()`, which follows Art. III.1. Nothing here sorts.
 *
 * ## What the 2026-09-16 redesign changed, and what it deliberately did not
 *
 * Changed: the amount is now the loudest thing on the row, at a size the eye
 * lands on first. That is the identity of this product — the numbers are the
 * brand, set in tabular mono so two rows line up and can be compared without
 * being read. The leader gets a surface of its own instead of a thin rule.
 *
 * **Not changed: anything the T020 barrier reserves.** The bracket control's
 * prominence is decision #2 (`BracketEmphasis`), El Dorado's representation is
 * #1, and the Binance cross is #3. Restyling a control is not deciding it, so
 * the selectors kept their structure and their weight relative to each other.
 *
 * Still true from before, and re-checked rather than assumed:
 *  - **No colour by price.** A ranking that paints rows cheap-green and
 *    expensive-red tells the reader what to think before they read the number.
 *    The leader is marked by size, weight and a surface — three things that
 *    survive a screenshot and a colour-blind reader; colour alone survives
 *    neither.
 *  - **The margin stays quiet.** The amount is what the person receives or
 *    pays; the margin is context for it. Equal weight would invite ranking by
 *    the wrong one.
 */
import { Badge } from '@/components/ui/badge';
import { providerName } from '../lib/catalogue.ts';
import { ageLabel, minutesSince, STALE_MINUTES } from '../lib/freshness.ts';
import type { EldoradoPolicy } from '../lib/pending.ts';
import type { LatestQuote } from '../lib/quotes.ts';
import {
  assetLabel,
  channelLabel,
  directionLabel,
  limitReasonLabel,
  modeHint,
  modeLabel,
  rank,
  UNDECIDED_PROVIDER,
} from '../lib/ranking.ts';

interface Props {
  quotes: LatestQuote[];
  direction: LatestQuote['direction'];
  bracket: number;
  now: Date;
  /** Required, and `undefined` means the T025 decision is still open. */
  eldorado: EldoradoPolicy | undefined;
}

const { quotes, direction, bracket, now, eldorado } = Astro.props;
const { rows, outOfRange, deferred } = rank(quotes, eldorado);

const cop = new Intl.NumberFormat('es-CO', { maximumFractionDigits: 0 });

/**
 * The margin shown is `markup_vs_mid`, not `markup_vs_trm`, and Art. III.5
 * decides that: the live mid-market rate is the base of every margin
 * calculation, because the TRM is a single daily value that freezes over
 * weekends and holidays. Measuring against a frozen reference would show a
 * margin moving when only the calendar did.
 *
 * The TRM stays as the user-facing reference in its own block, which is the
 * other half of III.5 — the two have separate roles and are not interchangeable.
 *
 * Positive always means worse than the reference, in both directions, since the
 * correction applied on 2026-09-14. It is computed from the effective amount,
 * so a provider with a good advertised rate and a separate fee cannot hide in it.
 */
const pct = new Intl.NumberFormat('es-CO', {
  style: 'percent',
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});

const receives = direction === 'usd_to_cop';

/**
 * The rate per dollar, added 2026-09-16, and **which rate** is the whole point.
 *
 * Art. III.1 governs the *order*: the ranking is sorted by the variable side,
 * never by the advertised rate. It does not forbid showing a rate — but showing
 * the wrong one would hand the reader the mistake the article exists to
 * prevent, because they would re-sort the list in their head.
 *
 * So the number on the row is `effective_rate`: pesos actually received per
 * dollar actually given, fees included. It agrees with the order by
 * construction, so the list can never contradict the number printed on it.
 *
 * Measured on the 2026-09-16 capture, and this is why the distinction is not
 * academic — Wise at 100 USD:
 *
 *   gross_rate      3.101,00   ← above mid-market, looks like the best offer
 *   mid-market      3.099,99
 *   effective_rate  2.816,95   ← what you get: 9,1 % worse
 *
 * The source reports a 9,16 USD fixed fee on 100 USD and its own
 * `receivedAmount` matches ours exactly, so the gap is real and is Wise's, not
 * an artefact of ours. Printing 3.101 next to 281.695 COP would have been a
 * true number doing a lie's work.
 *
 * The advertised rate is shown too, but only when it rounds to a different
 * figure than the effective one — which is a visibility rule, not a tuned
 * threshold. On single-book providers the two agree to within 0,02 % and the
 * contrast would be noise; on the ones charging a separate fee it is the most
 * useful thing on the row.
 */
const rate = new Intl.NumberFormat('es-CO', { maximumFractionDigits: 0 });
---

<article class="min-w-0">
  <header class="mb-4">
    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
      <h3 class="m-0 text-lg font-semibold tracking-tight">{directionLabel(direction)}</h3>
      <span class="amount text-muted-foreground text-sm font-medium">
        {cop.format(bracket)} USD
      </span>
    </div>
    <p class="text-faint m-0 mt-1 text-xs">
      Ordenado por {receives ? 'lo que recibís' : 'lo que pagás'}, no por la tasa
      anunciada.
    </p>
  </header>

  {
    rows.length === 0 && outOfRange.length === 0 && deferred.length === 0 && (
      <p class="text-muted-foreground text-sm">Sin datos para este monto.</p>
    )
  }

  {
    rows.length > 0 && (
      <ol class="m-0 list-none space-y-1 p-0">
        {rows.map(({ quote, position, behindBy }) => {
          const age = minutesSince(quote.captured_at, now);
          const stale = age > STALE_MINUTES;
          const amount = quote.fixed_side === 'in' ? quote.amount_out : quote.amount_in;
          const leader = position === 1;
          const effective = quote.effective_rate;
          const gross = quote.gross_rate;
          // Shown only when it reads as a different number. See the note above.
          //
          // The row that shows it carries `data-advertised="true"`, which is
          // what check:freshness looks for. It has to be an attribute: this
          // component's own subtitle says "no por la tasa anunciada", so
          // grepping for the word would match a page showing no advertised rate
          // at all — the same mistake the stale mark made once already.
          const advertisedDiffers =
            effective !== null && gross !== null && rate.format(gross) !== rate.format(effective);
          return (
            <li
              class:list={[
                'grid grid-cols-[1.25rem_1fr_auto] items-baseline gap-x-3 gap-y-1 rounded-lg px-2 py-3 transition-colors',
                leader
                  ? 'bg-accent ring-primary/25 -mx-2 shadow-xs ring-1'
                  : 'border-border border-b',
              ]}
              data-stale={stale ? 'true' : undefined}
            >
              <span
                class:list={[
                  'amount text-xs',
                  leader ? 'text-primary font-bold' : 'text-faint',
                ]}
              >
                {position}
              </span>

              <span class="flex min-w-0 flex-col gap-0.5">
                <a
                  href={`/proveedores/${quote.provider_id}`}
                  class:list={[
                    'truncate no-underline hover:underline',
                    leader ? 'text-foreground font-semibold' : 'text-foreground font-medium',
                  ]}
                >
                  {providerName(quote.provider_id)}
                </a>
                {quote.payment_method !== null && (
                  <span class="text-muted-foreground truncate text-xs">
                    {quote.payment_method}
                  </span>
                )}
                {/* Art. III.2: every row declares what it is, because the list
                    mixes products. The mode tag is what the Local/Remesa
                    selector used to say — removing the control moved the
                    distinction here, it did not delete it. Asset and channel
                    were already required by T025: somebody comparing a bank
                    transfer against USDT should see that it is USDT. */}
                <span class="mt-0.5 flex flex-wrap items-center gap-1.5">
                  <Badge
                    variant={quote.mode === 'remesa' ? 'outline' : 'secondary'}
                    class="px-1.5 py-0 text-[0.7rem] font-medium"
                    data-mode={quote.mode}
                    title={modeHint(quote.mode)}
                  >
                    {modeLabel(quote.mode)}
                  </Badge>
                  <span class="text-faint text-xs">
                    {assetLabel(quote.asset)} · {channelLabel(quote.channel)}
                  </span>
                </span>
              </span>

              <span class="flex flex-col items-end gap-0.5 text-right">
                <span class="flex items-baseline gap-1">
                  <span
                    class:list={[
                      'amount font-semibold tracking-tight',
                      leader ? 'text-2xl' : 'text-lg',
                    ]}
                  >
                    {amount === null ? '—' : cop.format(amount)}
                  </span>
                  <span class="text-faint text-xs">COP</span>
                </span>
                {effective !== null && (
                  <span class="flex items-baseline gap-1 whitespace-nowrap">
                    <span class="amount text-muted-foreground text-xs font-medium">
                      {rate.format(effective)}
                    </span>
                    <span class="text-faint text-xs">COP por dólar</span>
                  </span>
                )}

                {advertisedDiffers && gross !== null && (
                  <span
                    class="text-warn text-xs whitespace-nowrap"
                    data-advertised="true"
                    title="La tasa que el proveedor anuncia, antes de su comisión."
                  >
                    anuncia <span class="amount font-medium">{rate.format(gross)}</span>
                  </span>
                )}

                {behindBy > 0 && (
                  <span class="text-faint amount text-xs">
                    {receives ? '−' : '+'}
                    {cop.format(behindBy)}
                  </span>
                )}
                {quote.markup_vs_mid !== null && (
                  <span class="text-faint text-xs whitespace-nowrap">
                    {pct.format(quote.markup_vs_mid)} sobre el mercado
                  </span>
                )}
              </span>

              <span class="col-start-2 col-end-[-1] flex items-center gap-2">
                {stale ? (
                  <Badge
                    variant="outline"
                    class="border-warn/40 bg-warn-soft text-warn gap-1 px-1.5 py-0 text-[0.7rem] font-semibold"
                  >
                    desactualizado
                  </Badge>
                ) : null}
                <span class="text-faint text-xs">{ageLabel(age)}</span>
              </span>
            </li>
          );
        })}
      </ol>
    )
  }

  {
    outOfRange.length > 0 && (
      <div class="border-border mt-4 border-t pt-3">
        <h4 class="text-faint m-0 mb-1 text-xs font-medium">No disponibles a este monto</h4>
        <ul class="m-0 list-none space-y-0.5 p-0 text-sm">
          {outOfRange.map((quote) => (
            <li class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-medium">{providerName(quote.provider_id)}</span>
              <span class="text-faint text-xs">{limitReasonLabel(quote.limit_reason)}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    deferred.length > 0 && (
      <div class="border-border-strong mt-4 rounded-lg border border-dashed p-3">
        <h4 class="m-0 mb-2 text-sm font-semibold">
          {providerName(UNDECIDED_PROVIDER)}: {deferred.length} precios, sin comparar
          todavía
        </h4>
        <ul class="m-0 mb-2 list-none space-y-0.5 p-0 text-sm">
          {deferred.map((quote) => {
            const amount = quote.fixed_side === 'in' ? quote.amount_out : quote.amount_in;
            return (
              <li class="flex justify-between gap-3 py-0.5">
                <span class="text-muted-foreground truncate">{quote.payment_method}</span>
                <span class="amount font-medium">
                  {amount === null ? '—' : cop.format(amount)}
                </span>
              </li>
            );
          })}
        </ul>
        <p class="text-faint m-0 text-xs">
          Es el único proveedor que cotiza varios métodos de pago. Compararlo por
          su mejor método contra proveedores que tienen uno solo lo favorecería,
          así que cómo se muestra está sin decidir y sus precios quedan fuera del
          orden de arriba.
        </p>
      </div>
    )
  }
</article>
